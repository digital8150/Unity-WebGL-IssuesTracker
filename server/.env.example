PORT=4000
MONGO_URI=mongodb://localhost:27017/issue_tracker

# Translation worker starts with the server; enable or pause draining in the admin console.

# Secret used to sign JWTs — change this to a long random string in production
JWT_SECRET=dev-secret-change-in-production

# Optional independent rotation key for short-lived Arcade game tokens.
# When blank, a separate key is derived from JWT_SECRET.
GAME_TOKEN_SECRET=

# CORS origin for the web frontend during local dev
CORS_ORIGIN=http://localhost:5173

# URL this server is reachable at (used for GitHub OAuth redirect URI)
SERVER_URL=http://localhost:4000

# URL the web frontend is reachable at (used for GitHub OAuth post-login redirect)
FRONTEND_URL=http://localhost:5173

# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: ${SERVER_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth — create an application at https://discord.com/developers/applications
# OAuth2 > Add redirect: ${SERVER_URL}/api/auth/discord/callback  Scope: identify email
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Global Discord webhook fallback (per-game setting wins when set on the Game document)
DISCORD_WEBHOOK_URL=

# Cloudflare Turnstile — create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable bot-challenge verification in development.
TURNSTILE_SECRET_KEY=
